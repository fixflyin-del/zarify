# APP_URL: Public URL of the deployed ZARIFLY application (used for SEO sitemap & robots.txt)
APP_URL="http://localhost:3000"

# Optional Server-Side Admin Security Overrides (salted scrypt hash format: "<saltHex>:<hashHex>")
