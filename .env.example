# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed ZARIFLY application (used for SEO canonicals & PayU callbacks).
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string for Vercel / Neon / Supabase deployments
# (In Google AI Studio Cloud SQL, SQL_HOST/SQL_USER/SQL_PASSWORD/SQL_DB_NAME are auto-injected)
DATABASE_URL=""

# JWT & Session Signing Secret (generate a strong random 64-char secret in production)
JWT_SECRET="zarifly_dev_session_secret_change_in_production"

# Initial Admin Account Credentials (optional override for bootstrap admin)
ADMIN_BOOTSTRAP_EMAIL="admin@zarifly.com"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe@Zarifly2026"

# PayU India Payment Gateway Configuration
# Mode: "sandbox" (test.payu.in) or "production" (secure.payu.in)
PAYU_ENV="sandbox"
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""

# Cloudinary Media Management Configuration (images & reels video uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="zarifly"
