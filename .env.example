# APP_URL: Public URL of the deployed ZARIFLY application (used for SEO sitemap & robots.txt)
APP_URL="http://localhost:3000"

# Optional Server-Side Admin Security Overrides (salted scrypt hash format: "<saltHex>:<hashHex>")
# Leave blank to use the built-in server-side salted scrypt hash.
ADMIN_PIN_HASH=""

# Optional HMAC secret used to sign short-lived httpOnly Admin PIN verification cookies
ADMIN_PIN_COOKIE_SECRET=""

# Optional HMAC secret used to sign httpOnly WhatsApp Login session cookies
WHATSAPP_SESSION_SECRET=""

# Optional Meta WhatsApp Cloud API credentials for direct automated OTP delivery
# Leave blank to use the built-in official ZARIFLY WhatsApp (+91 9619586126) verification flow
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

